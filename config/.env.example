# fab-mcp Bambu Lab printer secrets
# Copy to .env (cp .env.example .env) and fill in real values, then set
# "bambu".enabled = true in config/servers.json and re-run wire-agents.py.
#
# WARNING: BAMBU_MODEL determines G-code generation. The WRONG model can
# crash the bed into the nozzle. Double-check against your printer.
#
# NOTE: wire-agents.py copies these values into each agent's MCP config
# (MCP clients read server env from there), and writes those files 0600.
# Keep this file private too: chmod 600 config/.env

# Printer LAN IP (Settings -> Network on the printer touchscreen)
PRINTER_HOST=192.168.1.100

# Serial number (physical sticker, or Settings -> Device Info)
BAMBU_SERIAL=01P00A123456789

# Access Code shown after enabling Developer Mode (this is the "token")
BAMBU_TOKEN=your_access_code

# One of: p1s p1p p2s x1c x1e a1 a1mini h2d h2s h2c
BAMBU_MODEL=p1s

# Build plate: textured_plate | cool_plate | engineering_plate | high_temp_plate
BED_TYPE=textured_plate

# Slicer used for CLI slicing operations
SLICER_TYPE=bambustudio

# Path to the BambuStudio binary. Auto-detect yours with:
#   bash scripts/detect-paths.sh
#   NixOS : /run/current-system/sw/bin/bambu-studio
#   Ubuntu: ~/Applications/BambuStudio_ubuntu-XX.XX_*.AppImage (AppImage)
SLICER_PATH=/run/current-system/sw/bin/bambu-studio

# Optional: flatten BBL profile inheritance to work around upstream CLI bugs
# BAMBU_CLI_FLATTEN=true
